# NKOSI Configuration
# Generated by Ansible - do not edit manually

[agent]
name = "{{ nkosi_agent_name }}"
db_path = "{{ nkosi_db_path }}"
log_path = "{{ nkosi_log_dir }}/nkosi.log"

[monitors]
watched_paths = ["/bin", "/sbin", "/usr/bin", "/usr/sbin", "/etc"]
excluded_paths = ["/proc", "/sys", "/dev"]
process_monitor_enabled = true
network_monitor_enabled = true

[risk]
weights = { hash=40, yara=30, behavior=20, static_analysis=10 }
thresholds = { low=30, medium=60, high=80, critical=95 }

[quarantine]
path = "{{ nkosi_data_dir }}/quarantine"

[threat_intel]
malwarebazaar_enabled = true
threatfox_enabled = true
urlhaus_enabled = true
update_interval_secs = 3600

[logging]
level = "{{ nkosi_log_level }}"
format = "pretty"

{% if nkosi_notify_enabled %}
[notifications]
email = { enabled = true, smtp_host = "localhost", from = "nkosi@{{ ansible_hostname }}", to = "{{ nkosi_notify_email }}" }
{% if nkosi_notify_webhook %}
webhook = { enabled = true, url = "{{ nkosi_notify_webhook }}" }
{% endif %}
{% endif %}
