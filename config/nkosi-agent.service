[Unit]
Description=NKOSI Security Agent
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nkosi-agent
Restart=always
RestartSec=5
User=root
Group=root

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
# The agent must read its configured /home watch paths; prohibit writes while
# retaining visibility instead of hiding them entirely.
ProtectHome=read-only
ReadWritePaths=/var/lib/nkosi /var/log/nkosi
PrivateTmp=true
RuntimeDirectory=nkosi
RuntimeDirectoryMode=0755

# Resource limits
LimitNOFILE=65536
LimitNPROC=512
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
